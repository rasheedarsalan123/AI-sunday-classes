  {"cell_type":"markdown","id":"title","metadata":{},"source":["# Assignment solutions: email summarization and house-search conversations\n","\n","Run from the `evals-repo` folder. Gemini calls use `common.py` and `GEMINI_API_KEY` from `.env`. Outputs are saved under `data/`."]},
  {"cell_type":"code","execution_count":null,"id":"setup","metadata":{},"outputs":[],"source":["from common import ask, chat, load_data\n","import json, re\n","from pathlib import Path\n","import pandas as pd\n","\n","ROOT = Path.cwd()\n","assert (ROOT / 'common.py').exists(), 'Run this notebook from evals-repo.'\n","DATA_DIR = ROOT / 'data'\n","data = load_data()\n","emails = json.loads((DATA_DIR / 'assignment_emails.json').read_text(encoding='utf-8'))\n","labels = json.loads((DATA_DIR / 'assignment_email_labels.json').read_text(encoding='utf-8'))\n"]},
  {"cell_type":"markdown","id":"a1","metadata":{},"source":["## Assignment 1: evaluate and improve an email summarizer"]},
  {"cell_type":"code","execution_count":null,"id":"a1-code","metadata":{},"outputs":[],"source":["def check_email(summary, email):\n","    text = summary or ''\n","    lines = [line.strip() for line in text.splitlines() if line.strip()]\n","    sender_ok = bool(lines) and lines[0] == f\"Sender: {email['expected_sender']}\"\n","    bullets = [line for line in lines[1:] if re.match(r'^[-*]\\s+', line)]\n","    leakage = any(token.casefold() in text.casefold() for token in email['signature_tokens'] if token)\n","    result = {'sender_line': sender_ok, 'exactly_3_bullets': len(bullets) == 3, 'no_signature_leakage': not leakage}\n","    result['overall'] = all(result.values())\n","    return result\n","\n","OUTPUT_PATH = DATA_DIR / 'assignment_email_outputs.json'\n","def summarize_all(prompt, prompt_name):\n","    saved = json.loads(OUTPUT_PATH.read_text(encoding='utf-8')) if OUTPUT_PATH.exists() else {}\n","    by_id = {row['id']: row for row in saved.get(prompt_name, [])}\n","    for email in emails:\n","        if email['id'] not in by_id:\n","            answer = ask(email['text'], system=prompt, temperature=0) or ''\n","            by_id[email['id']] = {'id': email['id'], 'summary': answer}\n","            saved[prompt_name] = [by_id[e['id']] for e in emails if e['id'] in by_id]\n","            OUTPUT_PATH.write_text(json.dumps(saved, indent=2, ensure_ascii=False), encoding='utf-8')\n","    return [by_id[e['id']] for e in emails]\n","\n","basic_prompt = 'Summarize the email clearly and concisely.'\n","improved_prompt = '''Summarize the current email accurately. Use exactly this format:\\nSender: <sender name from the first From header>\\n- <key point/action>\\n- <key point/action>\\n- <key point/action>\\nUse exactly 3 bullets. Exclude signatures, phone numbers, email addresses, disclaimers, and forwarded or quoted messages. Do not invent details. Output only the required line and bullets.'''\n","basic = summarize_all(basic_prompt, 'basic')\n","improved = summarize_all(improved_prompt, 'improved')\n","\n","def checks(outputs):\n","    lookup = {row['id']: row.get('summary', '') for row in outputs}\n","    return {email['id']: check_email(lookup.get(email['id'], ''), email) for email in emails}\n","before, after = checks(basic), checks(improved)\n","\n","def kappa(a, b):\n","    if len(a) != len(b): raise ValueError('Label lists must have equal lengths')\n","    if not a: raise ValueError('Label lists cannot be empty')\n","    a = [str(x).strip().casefold() for x in a]; b = [str(x).strip().casefold() for x in b]\n","    if any(x not in {'pass', 'fail'} for x in a + b): raise ValueError('Labels must be Pass or Fail')\n","    observed = sum(x == y for x, y in zip(a, b)) / len(a)\n","    pa = sum(x == 'pass' for x in a) / len(a); pb = sum(x == 'pass' for x in b) / len(b)\n","    expected = pa * pb + (1-pa) * (1-pb)\n","    return observed, None if expected == 1 else (observed - expected) / (1 - expected)\n","agreement, k = kappa(labels['annotator_1'], labels['annotator_2'])\n","print('Label agreement:', f'{agreement:.1%}', '| Cohen kappa:', 'undefined' if k is None else round(k, 3))\n","def rates(rows):\n","    keys = next(iter(rows.values()))\n","    return {key: sum(row[key] for row in rows.values()) / len(rows) for key in keys}\n","print(pd.DataFrame({'basic': rates(before), 'improved': rates(after)}).to_string())\n","print('Failure counts before:', {key: sum(not row[key] for row in before.values()) for key in next(iter(before.values()))})\n","print('Failure counts after:', {key: sum(not row[key] for row in after.values()) for key in next(iter(after.values()))})\n","print('Saved email outputs to', OUTPUT_PATH)\n"]},
  {"cell_type":"markdown","id":"a2","metadata":{},"source":["## Assignment 2: evaluate a conversational house-search assistant"]},
  {"cell_type":"code","execution_count":null,"id":"a2-code","metadata":{},"outputs":[],"source":["ch6 = data['ch6']\n","houses = ch6['houses']\n","house_by_id = {house['id']: house for house in houses}\n","house_system = ch6['assistant_system'].replace('{houses}', json.dumps(houses)) + '\\nWhen recommending houses, return a JSON object with a `recommended_house_ids` list and a short explanation.'\n","specs = [\n","    {'id':'normal_search','split':'development','goal':'Recommend at least 3 bedrooms under $500,000.','human_label':'Pass','users':['I need at least 3 bedrooms under $500,000.','What options fit?']},\n","    {'id':'ambiguous','split':'development','goal':'Clarify the user needs before making a recommendation.','human_label':'Fail','users':['Find me a nice house.','You decide what is good.']},\n","    {'id':'changed_budget','split':'final_test','goal':'Respect the revised maximum budget of $450,000 and at least 3 bedrooms.','human_label':'Fail','users':['I need at least 3 bedrooms and have $500,000.','Actually my maximum is $450,000. Which house fits?']},\n","    {'id':'incorrect_claim','split':'final_test','goal':'Correctly explain that H2 has only 2 bedrooms.','human_label':'Pass','users':['H2 has 3 bedrooms, right?']}","]},
  {"cell_type":"code","execution_count":null,"id":"a2-code-cont","metadata":{},"outputs":[],"source":["CONVERSATIONS_PATH = DATA_DIR / 'assignment_conversations.json'","conversations_by_id = {}","if CONVERSATIONS_PATH.exists():\n","    conversations_by_id = {item['id']: item for item in json.loads(CONVERSATIONS_PATH.read_text(encoding='utf-8'))}\n","for spec in specs:\n","    if spec['id'] in conversations_by_id: continue\n","    history = []\n","    for user_message in spec['users'][:4]:\n","        history.append({'role':'user','content':user_message})\n","        reply = chat(history, system=house_system, temperature=0)\n","        history.append({'role':'assistant','content':reply or ''})\n","    item = {key:spec[key] for key in ('id','split','goal','human_label')} | {'messages':history,'fixture':False}\n","    conversations_by_id[spec['id']] = item\n","    CONVERSATIONS_PATH.write_text(json.dumps([conversations_by_id[s['id']] for s in specs if s['id'] in conversations_by_id], indent=2, ensure_ascii=False), encoding='utf-8')\n","conversations = [conversations_by_id[s['id']] for s in specs]\n","assert all(sum(m['role']=='user' for m in c['messages']) <= 4 for c in conversations)\n","\n","base_judge = '''Judge whether the assistant fully achieved the conversation goal accurately and respected every user constraint. Correct false claims. Ask a clarifying question when the request is ambiguous and do not invent preferences. Return JSON only: {\\\"answer\\\":\\\"Pass or Fail\\\",\\\"reasoning\\\":\\\"one short sentence\\\"}.'''\n","def transcript(conversation): return '\\n'.join(f\"{m['role'].upper()}: {m['content']}\" for m in conversation['messages'])\n","development = [c for c in conversations if c['split'] == 'development']\n","final_test = [c for c in conversations if c['split'] == 'final_test']\n","assert sorted(c['human_label'] for c in development) == ['Fail','Pass']\n","assert sorted(c['human_label'] for c in final_test) == ['Fail','Pass']\n","judge_prompt = base_judge + '\\nDevelopment calibration examples (use these to apply the goal consistently):\\n' + '\\n\\n'.join(f\"Goal: {c['goal']}\\n{transcript(c)}\\nHuman label: {c['human_label']}\" for c in development)\n","judged = []\n","for conversation in final_test:\n","    result = ask(judge_prompt + f\"\\n\\nGoal: {conversation['goal']}\\n{transcript(conversation)}\", as_json=True)\n","    if isinstance(result, list): result = result[0]\n","    verdict = str(result.get('answer','')).strip().capitalize()\n","    if verdict not in {'Pass','Fail'}: raise ValueError(f'Invalid judge label: {result}')\n","    judged.append({'id':conversation['id'],'human':conversation['human_label'],'judge':verdict,'reasoning':str(result.get('reasoning',''))})\n","n_pass = sum(row['human']=='Pass' for row in judged); n_fail = sum(row['human']=='Fail' for row in judged)\n","tpr = sum(row['human']=='Pass' and row['judge']=='Pass' for row in judged) / n_pass\n","tnr = sum(row['human']=='Fail' and row['judge']=='Fail' for row in judged) / n_fail\n","print(pd.DataFrame(judged).to_string(index=False))\n","print('TPR:', tpr, '| TNR:', tnr)\n","(DATA_DIR / 'assignment_judge_results.json').write_text(json.dumps({'frozen_prompt':judge_prompt,'final_test_results':judged,'TPR':tpr,'TNR':tnr},indent=2,ensure_ascii=False),encoding='utf-8')\n"]},
  {"cell_type":"code","execution_count":null,"id":"budget-check","metadata":{},"outputs":[],"source":["passing = next(c for c in conversations if c['human_label'] == 'Pass')\n","changed = 'Change of plan: I need at least 4 bedrooms, maximum $500,000.'\n","multi_history = [dict(m) for m in passing['messages']] + [{'role':'user','content':changed}]\n","multi_reply = chat(multi_history, system=house_system, temperature=0) or ''\n","all_user_requirements = ' '.join(m['content'] for m in multi_history if m['role']=='user')\n","single_reply = ask(all_user_requirements, system=house_system, temperature=0) or ''\n","def validate_recommendations(reply, max_price=500000, min_bedrooms=4):\n","    try:\n","        parsed = json.loads(reply)\n","        ids = parsed.get('recommended_house_ids', []) if isinstance(parsed, dict) else parsed\n","    except (json.JSONDecodeError, TypeError):\n","        ids = re.findall(r'(?<![A-Za-z0-9])H[0-9]+(?![A-Za-z0-9])', reply or '')\n","    ids = list(dict.fromkeys(str(i) for i in ids))\n","    unknown = [i for i in ids if i not in house_by_id]\n","    invalid = [i for i in ids if i in house_by_id and (house_by_id[i]['price'] > max_price or house_by_id[i]['bedrooms'] < min_bedrooms)]\n","    return {'house_ids':ids,'unknown_ids':unknown,'out_of_constraints':invalid,'requirements_met':bool(ids) and not unknown and not invalid}\n","comparison = []\n","for method, reply in [('multi-turn',multi_reply),('single prompt',single_reply)]:\n","    comparison.append({'method':method,**validate_recommendations(reply),'reply':reply})\n","print(pd.DataFrame(comparison).to_string(index=False))\n","(DATA_DIR / 'assignment_budget_comparison.json').write_text(json.dumps(comparison,indent=2,ensure_ascii=False),encoding='utf-8')\n"]}
